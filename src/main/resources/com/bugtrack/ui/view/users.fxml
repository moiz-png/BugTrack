<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bugtrack.ui.controller.UsersController"
      spacing="16">

    <VBox spacing="10" HBox.hgrow="ALWAYS">
        <HBox spacing="8">
            <Button text="New user" styleClass="primary" onAction="#onNew"/>
        </HBox>
        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="180"/>
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="220"/>
                <TableColumn fx:id="roleColumn" text="Role" prefWidth="120"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

    <VBox styleClass="form-card" spacing="8" prefWidth="330" minWidth="300">
        <Label fx:id="formTitle" styleClass="section-title"/>

        <Label text="Full name" styleClass="field-label"/>
        <TextField fx:id="nameField"/>

        <Label text="Email" styleClass="field-label"/>
        <TextField fx:id="emailField" promptText="name@company.com"/>

        <Label text="Role" styleClass="field-label"/>
        <ComboBox fx:id="roleCombo" maxWidth="Infinity"/>

        <VBox fx:id="passwordBox" spacing="8">
            <Label text="Initial password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="At least 6 characters"/>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>

        <HBox spacing="8">
            <Button text="Save" styleClass="primary" onAction="#onSave"/>
            <Button fx:id="toggleActiveButton" text="Deactivate" onAction="#onToggleActive"/>
        </HBox>
        <Button fx:id="resetPasswordButton" text="Reset password…" styleClass="ghost" onAction="#onResetPassword"/>
    </VBox>
</HBox>
