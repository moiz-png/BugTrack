<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bugtrack.ui.controller.BugFormController"
            fitToWidth="true" styleClass="page-scroll">

    <VBox styleClass="form-card" spacing="14" maxWidth="900">
        <Label fx:id="formTitle" styleClass="section-title"/>

        <GridPane hgap="14" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="150" prefWidth="160"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Project *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="projectCombo" promptText="Choose a project" maxWidth="Infinity"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Module" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="moduleCombo" promptText="Affected module" maxWidth="Infinity"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Version" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="versionField" promptText="e.g. 1.2.0"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Title *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="titleField" promptText="Short summary of the problem"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <VBox fx:id="duplicateBox" styleClass="duplicate-box" spacing="6"
                  GridPane.rowIndex="4" GridPane.columnIndex="1">
                <Label styleClass="warning-text" wrapText="true"
                       text="Possible duplicates. Check these before submitting (double-click to open)."/>
                <ListView fx:id="duplicateList" prefHeight="110"/>
            </VBox>

            <Label text="Description *" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="4"
                      promptText="What is wrong? Where does it happen?"
                      GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <Label text="Steps to reproduce *" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextArea fx:id="stepsArea" wrapText="true" prefRowCount="4"
                      promptText="1. Open ...&#10;2. Click ...&#10;3. See error"
                      GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            <Label text="Expected result" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
            <TextArea fx:id="expectedArea" wrapText="true" prefRowCount="2"
                      GridPane.rowIndex="7" GridPane.columnIndex="1"/>

            <Label text="Actual result" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
            <TextArea fx:id="actualArea" wrapText="true" prefRowCount="2"
                      GridPane.rowIndex="8" GridPane.columnIndex="1"/>

            <Label text="Severity *" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
            <ComboBox fx:id="severityCombo" prefWidth="200" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

            <Label fx:id="priorityLabel" text="Priority" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
            <ComboBox fx:id="priorityCombo" prefWidth="200" GridPane.rowIndex="10" GridPane.columnIndex="1"/>

            <Label text="Environment" GridPane.rowIndex="11" GridPane.columnIndex="0"/>
            <TextField fx:id="environmentField" promptText="OS, Java version, screen size, browser…"
                       GridPane.rowIndex="11" GridPane.columnIndex="1"/>

            <Label text="Attachments" GridPane.rowIndex="12" GridPane.columnIndex="0"/>
            <VBox spacing="6" GridPane.rowIndex="12" GridPane.columnIndex="1">
                <ListView fx:id="attachmentList" prefHeight="90"/>
                <HBox spacing="8">
                    <Button text="Add files…" onAction="#onAddAttachment"/>
                    <Button text="Remove" styleClass="ghost" onAction="#onRemoveAttachment"/>
                </HBox>
            </VBox>
        </GridPane>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>

        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button text="Cancel" styleClass="ghost" onAction="#onCancel"/>
            <Button fx:id="submitButton" text="Submit bug" styleClass="primary" onAction="#onSubmit"/>
        </HBox>
    </VBox>
</ScrollPane>
