<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bugtrack.ui.controller.ReportsController"
      spacing="12">

    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="typeCombo" prefWidth="300"/>
        <Button text="Generate" styleClass="primary" onAction="#onGenerate"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="csvButton" text="Export CSV" disable="true" onAction="#onExportCsv"/>
        <Button fx:id="pdfButton" text="Export PDF" disable="true" onAction="#onExportPdf"/>
        <Button fx:id="saveSnapshotButton" text="Save snapshot" disable="true" onAction="#onSaveSnapshot"/>
        <Button text="Open snapshot…" styleClass="ghost" onAction="#onOpenSnapshot"/>
    </HBox>

    <VBox spacing="2">
        <Label fx:id="reportTitle" styleClass="section-title"/>
        <Label fx:id="reportMeta" styleClass="muted"/>
    </VBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <BarChart fx:id="chart" legendVisible="false" animated="false" styleClass="card" HBox.hgrow="ALWAYS">
            <xAxis>
                <CategoryAxis/>
            </xAxis>
            <yAxis>
                <NumberAxis minorTickVisible="false"/>
            </yAxis>
        </BarChart>
        <TableView fx:id="valuesTable" prefWidth="340" minWidth="280">
            <columns>
                <TableColumn fx:id="itemColumn" text="Item" prefWidth="220"/>
                <TableColumn fx:id="valueColumn" text="Value" prefWidth="100"/>
            </columns>
        </TableView>
    </HBox>
</VBox>
