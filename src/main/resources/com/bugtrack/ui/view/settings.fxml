<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bugtrack.ui.controller.SettingsController"
            fitToWidth="true" styleClass="page-scroll">

    <VBox styleClass="form-card" spacing="10" maxWidth="600">
        <Label text="Appearance" styleClass="section-title"/>
        <Label text="Theme" styleClass="field-label"/>
        <ComboBox fx:id="themeCombo" prefWidth="200"/>

        <Label text="Bug list" styleClass="section-title"/>
        <Label text="Default project for new bugs" styleClass="field-label"/>
        <HBox spacing="8">
            <ComboBox fx:id="defaultProjectCombo" promptText="None" prefWidth="260"/>
            <Button text="Clear" styleClass="ghost" onAction="#onClearDefaultProject"/>
        </HBox>
        <Label text="Bugs per page" styleClass="field-label"/>
        <Spinner fx:id="pageSizeSpinner" prefWidth="120" editable="true"/>

        <Label text="Saved searches" styleClass="section-title"/>
        <ListView fx:id="savedSearchList" prefHeight="140"/>
        <Button text="Delete selected search" styleClass="ghost" onAction="#onDeleteSearch"/>

        <Label styleClass="hint" wrapText="true"
               text="Your settings are saved to your profile and restored the next time you log in."/>
        <HBox alignment="CENTER_RIGHT">
            <Button text="Save settings" styleClass="primary" onAction="#onSave"/>
        </HBox>
    </VBox>
</ScrollPane>
