<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bugtrack.ui.controller.BugDetailController"
            fitToWidth="true" styleClass="page-scroll">

    <VBox spacing="14">
        <Button text="← Back to bugs" styleClass="link-button" onAction="#onBack"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="bugIdLabel" styleClass="bug-id"/>
            <Label fx:id="bugTitle" styleClass="bug-title" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusBadge" styleClass="badge, badge-large"/>
        </HBox>

        <HBox fx:id="actionBar" spacing="8" alignment="CENTER_LEFT"/>

        <GridPane styleClass="card" hgap="24" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="110"/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="110"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Project" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="projectValue" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Module" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <Label fx:id="moduleValue" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Version" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="versionValue" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Severity" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <Label fx:id="severityValue" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <Label text="Priority" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="priorityValue" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Due date" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <Label fx:id="dueValue" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

            <Label text="Reporter" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="reporterValue" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Assignee" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
            <Label fx:id="assigneeValue" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

            <Label text="Reopened" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="reopenValue" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Environment" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
            <Label fx:id="environmentValue" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="3"/>

            <Label text="Reported" styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label fx:id="createdValue" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label text="Last updated" styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
            <Label fx:id="updatedValue" GridPane.rowIndex="5" GridPane.columnIndex="3"/>
        </GridPane>

        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="detail-tabs" minHeight="360">
            <Tab text="Details">
                <VBox styleClass="tab-body" spacing="6">
                    <Label text="Description" styleClass="field-label"/>
                    <Label fx:id="descriptionValue" wrapText="true"/>
                    <Label text="Steps to reproduce" styleClass="field-label"/>
                    <Label fx:id="stepsValue" wrapText="true"/>
                    <Label text="Expected result" styleClass="field-label"/>
                    <Label fx:id="expectedValue" wrapText="true"/>
                    <Label text="Actual result" styleClass="field-label"/>
                    <Label fx:id="actualValue" wrapText="true"/>
                </VBox>
            </Tab>

            <Tab text="Resolution">
                <VBox styleClass="tab-body" spacing="6">
                    <Label text="Root cause" styleClass="field-label"/>
                    <Label fx:id="rootCauseValue" wrapText="true"/>
                    <Label text="Fix description" styleClass="field-label"/>
                    <Label fx:id="fixValue" wrapText="true"/>
                    <Label text="Commit / build reference" styleClass="field-label"/>
                    <Label fx:id="commitValue"/>
                    <Label text="Resolved by" styleClass="field-label"/>
                    <Label fx:id="resolvedByValue"/>
                </VBox>
            </Tab>

            <Tab fx:id="commentsTab" text="Comments">
                <VBox styleClass="tab-body" spacing="10">
                    <VBox fx:id="commentsBox" spacing="8"/>
                    <HBox fx:id="replyBar" spacing="8" alignment="CENTER_LEFT" styleClass="reply-bar">
                        <Label fx:id="replyingToLabel" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Cancel reply" styleClass="link-button" onAction="#onCancelReply"/>
                    </HBox>
                    <TextArea fx:id="commentArea" wrapText="true" prefRowCount="3"
                              promptText="Write a comment. Use @name to mention someone."/>
                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Post comment" styleClass="primary" onAction="#onPostComment"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Attachments">
                <VBox styleClass="tab-body" spacing="8">
                    <ListView fx:id="attachmentList" prefHeight="200"/>
                    <HBox spacing="8">
                        <Button text="Add files…" onAction="#onAddAttachment"/>
                        <Button text="Open" styleClass="ghost" onAction="#onOpenAttachment"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="History">
                <VBox styleClass="tab-body">
                    <TableView fx:id="historyTable" prefHeight="280">
                        <columns>
                            <TableColumn fx:id="historyWhen" text="When" prefWidth="150"/>
                            <TableColumn fx:id="historyWho" text="Who" prefWidth="140"/>
                            <TableColumn fx:id="historyAction" text="Action" prefWidth="170"/>
                            <TableColumn fx:id="historyChange" text="Change" prefWidth="320"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>
</ScrollPane>
