<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bugtrack.ui.controller.BugListController"
      spacing="10">

    <VBox styleClass="card" spacing="8">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Search title or description (Ctrl+F)" prefWidth="280"/>
            <ComboBox fx:id="projectCombo" promptText="Project" prefWidth="160"/>
            <ComboBox fx:id="moduleCombo" promptText="Module" prefWidth="140"/>
            <ComboBox fx:id="statusCombo" promptText="Status" prefWidth="160"/>
            <ComboBox fx:id="priorityCombo" promptText="Priority" prefWidth="120"/>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <ComboBox fx:id="severityCombo" promptText="Severity" prefWidth="120"/>
            <ComboBox fx:id="assigneeCombo" promptText="Assignee" prefWidth="160"/>
            <DatePicker fx:id="fromDate" promptText="Reported from" prefWidth="150"/>
            <DatePicker fx:id="toDate" promptText="Reported to" prefWidth="150"/>
            <Button text="Clear filters" styleClass="ghost" onAction="#onClearFilters"/>
        </HBox>
    </VBox>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="savedSearchCombo" promptText="Saved searches" prefWidth="190"
                  onAction="#onSavedSearchChosen"/>
        <Button text="Save search" onAction="#onSaveSearch"/>
        <Button text="Delete" styleClass="ghost" onAction="#onDeleteSearch"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox fx:id="bulkBox" spacing="8" alignment="CENTER_LEFT">
            <Label text="Selected:" styleClass="muted"/>
            <Button text="Assign…" onAction="#onBulkAssign"/>
            <Button text="Close verified" onAction="#onBulkClose"/>
        </HBox>
        <Label fx:id="resultLabel" styleClass="muted"/>
    </HBox>

    <TableView fx:id="bugTable" VBox.vgrow="ALWAYS"/>
    <Pagination fx:id="pagination" maxPageIndicatorCount="7" styleClass="pager"/>
</VBox>
