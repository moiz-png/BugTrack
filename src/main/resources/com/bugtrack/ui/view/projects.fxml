<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bugtrack.ui.controller.ProjectsController"
      spacing="16">

    <VBox spacing="10" prefWidth="280" minWidth="240">
        <Button text="New project" styleClass="primary" onAction="#onNew"/>
        <ListView fx:id="projectList" VBox.vgrow="ALWAYS"/>
    </VBox>

    <ScrollPane fitToWidth="true" styleClass="page-scroll" HBox.hgrow="ALWAYS">
        <VBox styleClass="form-card" spacing="8">
            <Label fx:id="formTitle" styleClass="section-title"/>

            <Label text="Name *" styleClass="field-label"/>
            <TextField fx:id="nameField"/>

            <Label text="Description" styleClass="field-label"/>
            <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="3"/>

            <Label text="Current version" styleClass="field-label"/>
            <TextField fx:id="versionField" promptText="e.g. 1.0.0" maxWidth="200"/>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Modules / components" styleClass="field-label"/>
                    <ListView fx:id="moduleList" prefHeight="180"/>
                    <HBox spacing="6">
                        <TextField fx:id="moduleField" promptText="New module" HBox.hgrow="ALWAYS"
                                   onAction="#onAddModule"/>
                        <Button text="Add" onAction="#onAddModule"/>
                        <Button text="Remove" styleClass="ghost" onAction="#onRemoveModule"/>
                    </HBox>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Team members" styleClass="field-label"/>
                    <ListView fx:id="memberList" prefHeight="180"/>
                    <HBox spacing="6">
                        <ComboBox fx:id="memberCombo" promptText="Choose a user" HBox.hgrow="ALWAYS"
                                  maxWidth="Infinity"/>
                        <Button text="Add" onAction="#onAddMember"/>
                        <Button text="Remove" styleClass="ghost" onAction="#onRemoveMember"/>
                    </HBox>
                </VBox>
            </HBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>
            <HBox alignment="CENTER_RIGHT">
                <Button text="Save project" styleClass="primary" onAction="#onSave"/>
            </HBox>
        </VBox>
    </ScrollPane>
</HBox>
